# Server-only configuration. Never add a VITE_ prefix to secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/devtrace
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:3001,http://localhost:3001
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional on loopback; mandatory (32+ characters) for a network-facing server.
API_TOKEN=
# Public URL only. Blank uses Vite's /api proxy locally.
VITE_API_BASE_URL=
# Dedicated MongoDB instance for integration tests; tests use a random DB name.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
